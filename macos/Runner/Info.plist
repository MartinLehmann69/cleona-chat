<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Required since macOS Sonoma for any app that talks to the local
	     network (LAN discovery, IPv4/IPv6 multicast, broadcast). Cleona
	     bootstraps peers via broadcast + multicast, so this prompt appears
	     on first launch. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cleona sucht andere Cleona-Nodes im lokalen Netzwerk per Broadcast und Multicast — nur so findet dein Gerät ohne zentralen Server einen Einstiegspunkt ins P2P-Netz.</string>
	<!-- Required since macOS 10.14 for any app that touches an input device.
	     Without this key the system kills the process at the first
	     AudioUnitInitialize/AudioQueue access — no prompt, no recoverable
	     error. Cleona runs unsandboxed (see DebugProfile.entitlements), so
	     the TCC usage string is the only gate that applies; there is no
	     sandbox entitlement to add instead (BUGFIX_CURRENT.md AV-V1.3 §3). -->
	<!-- Since S380 the QR scanner on macOS shows the camera as soon as one
	     is there (owner decision 10.09.2026: "Scanning follows the camera,
	     not the platform"). `mobile_scanner` supports macOS and has always
	     been registered in `macos/Flutter/GeneratedPluginRegistrant.swift:31`
	     — only this line was missing. Without it TCC ends the process on the
	     first AVCaptureDevice access, without a prompt and without a
	     catchable error. Cleona runs unsandboxed (see
	     Release.entitlements), so the TCC usage string is the only gate;
	     there is no `com.apple.security.device.camera` to add here. -->
	<key>NSCameraUsageDescription</key>
	<string>Cleona braucht die Kamera fuer Videoanrufe und zum Einlesen des QR-Einladungscodes eines Kontakts.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Cleona braucht das Mikrofon fuer Sprach- und Videoanrufe.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
