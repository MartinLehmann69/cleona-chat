<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Cleona is a P2P messenger. We need unrestricted access to the
	     user's home directory (the $HOME/.cleona profile) and to arbitrary
	     UDP ports for DHT + multicast discovery. Running outside the
	     sandbox matches the Linux/Windows behaviour; notarized non-App-Store
	     distribution does not require sandboxing.

	     For a future App Store build the sandbox would have to be
	     re-enabled, which would force the profile directory into
	     ~/Library/Containers/<bundle-id>/Data — that is a deliberate
	     architectural decision, not a v1 goal. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Dart VM uses JIT in debug/profile builds. The beta channel ships a
	     debug build (ios-build.yml "Build native libs + Flutter app"), and
	     since D-100 it runs under the Hardened Runtime. On macOS the Dart VM
	     allocates executable memory with MAP_JIT (dart-lang/sdk
	     runtime/vm/virtual_memory_posix.cc, AllocateAligned:
	     `if (is_executable && !ShouldDualMapExecutablePages())
	     map_flags |= MAP_JIT;`), which the Hardened Runtime allows only with
	     this key (Apple, "Hardened Runtime": allow-jit "may create writable
	     and executable memory using the MAP_JIT flag"). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- Outbound + inbound network access (explicit so the same file works
	     even if someone flips sandbox back on) -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- Microphone and camera under the Hardened Runtime (D-100) — the same
	     keys and the same sources as in Release.entitlements. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
