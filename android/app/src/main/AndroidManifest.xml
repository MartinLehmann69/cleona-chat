<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- V3.2 (Architektur §10.4, "Call integration"): self-managed -->
    <!-- ConnectionService. Normal protection level, kein Runtime-Dialog. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- Optional: mirror Cleona calendar events into the Android system -->
    <!-- calendar (Samsung / Google Calendar). Requested at runtime only -->
    <!-- when the user opts in via Settings. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:label="@string/app_name"
        android:name=".CleonaApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutter's own deep-linking MUST stay off. Since Flutter 3.24
                 the engine auto-enables it as soon as a VIEW+BROWSABLE
                 intent-filter is declared (see the cleona:// filter below)
                 and pushes the incoming URI as a *named route* through the
                 navigation channel. Cleona's MaterialApp (lib/main.dart)
                 only defines `home:` — no routes/onGenerateRoute/
                 onUnknownRoute — so every cleona:// link raised
                 "Could not find a generator for route ..." which the global
                 FlutterError handler escalated into a modal crash-consent
                 dialog (barrierDismissible: false), leaving the app stuck
                 behind it.
                 FlutterActivity.shouldHandleDeeplinking() reads exactly this
                 meta-data; with `false` the engine no longer forwards intent
                 data to the navigator. Cleona handles cleona:// itself via
                 MainActivity.handleDeepLinkIntent -> DeepLinkReceiver, which
                 does not use the navigation channel and is unaffected.
                 The app uses no named routes, so nothing else is lost. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep Link: cleona:// URI scheme for channel sharing + contact exchange. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="cleona"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".ShareTrampolineActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <!-- Android System-Share-Chooser: Cleona als Share-Target (Bug #U16). -->
            <!-- SEND: einzelne Inhalte (Text aus Browser, Bild aus Galerie, ...). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
                <data android:mimeType="application/*"/>
            </intent-filter>
            <!-- SEND_MULTIPLE: mehrere Inhalte gleichzeitig (z.B. mehrere Fotos). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>

        <service
            android:name=".CleonaForegroundService"
            android:foregroundServiceType="specialUse|microphone|dataSync"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_p2p_messaging_daemon" />
        </service>

        <!-- V3.2 self-managed ConnectionService (Architektur §10.4, Staging -->
        <!-- Zeile 7). Telecom bindet diesen Service; die Permission wird -->
        <!-- vom System gehalten, nicht von Cleona angefordert. -->
        <service
            android:name=".CleonaConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- §19.6 In-network update: FileProvider for APK install intent -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
